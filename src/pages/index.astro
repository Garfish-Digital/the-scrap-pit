<style lang="scss">
@import '../styles/variables';
@import '../styles/color_filters';

// ============================================================
// SECTION HEADER ENTRANCE ANIMATIONS
// Delays are baked into the base transition so they fire
// reliably when .revealed is added by JS.
// ============================================================

.section-header-animated {
  // Title enters first — no delay
  .display-title {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.3s ease-out 0s,
                transform 0.3s cubic-bezier(0.16, 1, 0.3, 1) 0s;
  }

  // Subtitle enters second
  .display-subtitle {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.3s ease-out 0.12s,
                transform 0.3s cubic-bezier(0.16, 1, 0.3, 1) 0.12s;
  }

  // Description enters third
  .hero-description {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.3s ease-out 0.24s,
                transform 0.3s cubic-bezier(0.16, 1, 0.3, 1) 0.24s;
  }

  &.revealed {
    .display-title,
    .display-subtitle,
    .hero-description {
      opacity: 1;
      transform: translateY(0);
    }
  }
}

// ============================================================
// SCROLL-TRIGGERED CONTENT REVEALS
// ============================================================

// Single-element reveal
.reveal-on-scroll {
  opacity: 0;
  transform: translateY(20px);
  transition: opacity 0.35s ease-out,
              transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);

  &.revealed {
    opacity: 1;
    transform: translateY(0);
  }
}

// Staggered grid children — initial hidden state with nth-child delays
.stagger-children {
  .training-block,
  .fighter-profile,
  .stat-item,
  .value-card,
  .leader-card,
  .pricing-card,
  .option-card {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.35s ease-out,
                transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @for $i from 1 through 6 {
    .training-block:nth-child(#{$i}),
    .fighter-profile:nth-child(#{$i}),
    .stat-item:nth-child(#{$i}),
    .value-card:nth-child(#{$i}),
    .leader-card:nth-child(#{$i}),
    .pricing-card:nth-child(#{$i}),
    .option-card:nth-child(#{$i}) {
      transition-delay: #{($i - 1) * 0.08}s;
    }
  }

  // When parent is revealed, cascade children to visible
  &.revealed {
    .training-block,
    .fighter-profile,
    .stat-item,
    .value-card,
    .leader-card,
    .pricing-card,
    .option-card {
      opacity: 1;
      transform: translateY(0);
    }
  }
}

// ============================================================
// HERO SECTION
// ============================================================

.section-hero {
  position: relative;
  min-height: 100vh;
  display: flex;
  align-items: center;
  overflow: hidden;

  .hero-background {
    position: absolute;
    top: 0;
    left: 0;
