---
// The Scrap Pit - Single Scroll Page
import FightLayout from '../layouts/FightLayout.astro';
import CombatButton from '../components/CombatButton.astro';
---

<FightLayout
  title="The Scrap Pit - Combat Sports Training Gym"
  description="Forged in Fire. Tested in Battle. Raw, uncompromising combat sports training for fighters who refuse to settle."
>

  <!-- ============================================================
       1. HERO — "THE ARENA"
       Background: DARK (hero image with overlay)
  ============================================================ -->
  <section class="hero section-hero" id="hero">
    <div class="hero-background mono-to-color">
      <div class="hero-image-overlay"></div>
    </div>

    <div class="container">
      <div class="hero-content">
        <h1 class="hero-title display-title">
          THE SCRAP PIT
        </h1>
        <p class="hero-subtitle display-subtitle">
          FORGET POTENTIAL - BRING THE OUTPUT
        </p>
        <!-- <p class="hero-description">
          Raw, uncompromising combat sports training.
        </p> -->

        <div class="hero-actions combat-btn-group">
          <CombatButton
            text="Start Your Journey"
            href="#contact"
            variant="accent"
            size="mega"
            className="brutalist-shadow"
          />
          <CombatButton
            text="View Training"
            href="#training"
            variant="victory"
            size="large"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       2. TRAINING — "THE GAUNTLET STAGES"
       Background: LIGHT 1 (ghost-white)
  ============================================================ -->
  <section class="training section" id="training">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">THE GAUNTLET STAGES</h2>
        <p class="section-description">
          Three paths to mastery. Each designed to break you down and build you back stronger.
        </p>
      </div>

      <div class="training-grid reveal-on-scroll stagger-children">
        <div class="training-block" data-stage="striking">
          <div class="training-image duotone-red-black">
            <div class="training-image-content">
              <div class="training-overlay"></div>
            </div>
          </div>
          <div class="training-content">
            <h3 class="training-title">STRIKING</h3>
            <p class="training-description">
              Master the art of controlled violence. Boxing, Muay Thai, and kickboxing
              fundamentals that make you precise under pressure.
            </p>
            <div class="training-stats">
              <span class="stat">45 MIN SESSIONS</span><br/>
              <span class="stat">HIGH INTENSITY</span><br/>
              <span class="stat">TECHNIQUE FOCUS</span>
            </div>
          </div>
        </div>

        <div class="training-block" data-stage="grappling">
          <div class="training-image duotone-gold-black">
            <div class="training-image-content">
              <div class="training-overlay"></div>
            </div>
          </div>
          <div class="training-content">
            <h3 class="training-title">GRAPPLING</h3>
            <p class="training-description">
              Control every outcome. Brazilian Jiu-Jitsu, wrestling, and submission
              techniques that make you dangerous at every range.
            </p>
            <div class="training-stats">
              <span class="stat">60 MIN SESSIONS</span><br/>
              <span class="stat">FULL TACTICAL FOCUS</span><br/>
              <span class="stat">MENTAL WARFARE</span>
            </div>
          </div>
        </div>

        <div class="training-block" data-stage="conditioning">
          <div class="training-image tritone-combat">
            <div class="training-image-content">
              <div class="training-overlay"></div>
            </div>
          </div>
          <div class="training-content">
            <h3 class="training-title">CONDITIONING</h3>
            <p class="training-description">
              Discover new ceilings. Brutal strength and conditioning sessions
              that build unbreakable mental and physical fortitude.
            </p>
            <div class="training-stats">
              <span class="stat">30 MIN SESSIONS</span><br/>
              <span class="stat">MAXIMUM INTENSITY</span><br/>
              <span class="stat">PAIN TOLERANCE</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       3. FIGHTERS — "IRON WILL PROFILES"
       Background: LIGHT 1 (ghost-white) — changed from bg-dark
  ============================================================ -->
  <section class="fighters section" id="fighters">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">IRON WILL PROFILES</h2>
        <p class="section-description">
          Voices changed by the pit. Real fighters, real stories, real results.
        </p>
      </div>

      <div class="fighters-grid reveal-on-scroll stagger-children">
        <div class="fighter-profile">
          <div class="fighter-image mono-to-color" style="background: url('/images/fighter-profile-1.webp') center/cover;">
          </div>
          <div class="fighter-content">
            <blockquote class="fighter-quote">The Scrap Pit didn't just teach me to fight. It taught me to conquer the voice in my head that says I can't.</blockquote>
            <cite class="fighter-name">- Marcus Ortiz</cite>
            <span class="fighter-title">Amateur Boxing Champion</span>
          </div>
        </div>

        <div class="fighter-profile">
          <div class="fighter-image mono-to-color" style="background: url('/images/fighter-profile-2.webp') center/cover;">
          </div>
          <div class="fighter-content">
            <blockquote class="fighter-quote">Every session breaks you down. Every session builds you back up. That's where real strength comes from.</blockquote>
            <cite class="fighter-name">- Dominique Kern</cite>
            <span class="fighter-title">MMA Fighter & Trainer</span>
          </div>
        </div>

        <div class="fighter-profile">
          <div class="fighter-image mono-to-color" style="background: url('/images/fighter-profile-3.webp') center/cover;">
          </div>
          <div class="fighter-content">
            <blockquote class="fighter-quote">The pit strips away everything fake. What's left is who you really are and what you're capable of.</blockquote>
            <cite class="fighter-name">- James "Blackout" Thompson</cite>
            <span class="fighter-title">Kickboxing Instructor</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       4. JOIN THE FIGHT — "THE CALL TO ARMS"
       Background: LIGHT 2 (subtle tri-gradient)
  ============================================================ -->
  <section class="join-fight section" id="join">
    <div class="container">
      <div class="join-content reveal-on-scroll">
        <div class="join-header">
          <h2 class="join-title display-title">
            BECOME SCRAPPY
          </h2>
          <p class="join-subtitle display-subtitle">
            AND LEARN TO FIGHT
          </p>
        </div>

        <div class="join-body">
          <p class="join-description">
            Are you ready to step into the pit? To face your fears, push your limits,
            and discover what you're truly capable of? You already know this is for you.
          </p>

          <div class="join-features">
            <div class="feature">
              <span class="feature-icon">🥊</span>
              <span class="feature-text">UNLIMITED TRAINING</span>
            </div>
            <div class="feature">
              <span class="feature-icon">🏆</span>
              <span class="feature-text">CHAMPIONSHIP COACHING</span>
            </div>
            <div class="feature">
              <span class="feature-icon">🔥</span>
              <span class="feature-text">BRUTAL CONDITIONING</span>
            </div>
          </div>

          <div class="join-actions combat-btn-group center">
            <CombatButton
              text="Start Free Trial"
              href="#contact"
              variant="accent"
              size="mega"
              className="impact-flash brutalist-shadow"
            />
            <CombatButton
              text="View Pricing"
              href="#pricing"
              variant="victory"
              size="large"
            />
          </div>

          <div class="join-guarantee">
            <p class="guarantee-text">
              <strong>30-DAY WARRIOR GUARANTEE:</strong> If you're not completely transformed
              in 30 days, we'll refund every penny. But you won't need it.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       5. ABOUT HEADER
       Background: DARK (iron-black gradient)
  ============================================================ -->
  <section class="about-hero section section-header-animated" id="about">
    <div class="container">
      <div class="about-hero-content">
        <h1 class="display-title">FORGED IN FIRE</h1>
        <p class="display-subtitle">THE SCRAP PIT PHILOSOPHY</p>
        <p class="hero-description">
          We don't just train fighters. We build warriors who refuse to accept limits,
          who turn pain into power, and who emerge from every battle stronger than before.
        </p>
      </div>
    </div>
  </section>

  <!-- ============================================================
       6. OUR STORY + STATS
       Background: LIGHT 1 (ghost-white)
  ============================================================ -->
  <section class="our-story section" id="our-story">
    <div class="container">
      <div class="story-grid reveal-on-scroll">

        <div class="story-content">
          <h2 class="section-title">
            <i class="fa-solid fa-fire"></i>
            OUR STORY
          </h2>

          <div class="story-text">
            <p>
              The Scrap Pit was born from a simple belief: <strong>authentic strength comes from authentic struggle</strong>.
              Founded in 2018 by former professional fighters who understood that training had become entertainment,
              we created a space where weakness is not coddled, but conquered.
            </p>

            <p>
              In an era of hyper-sensitivity and safe spaces, The Scrap Pit stands as a fortress of
              uncompromising training. Here, you don't get rewarded for showing up—you earn respect through
              raising your expectations and pushing beyond what you thought possible.
            </p>

            <p>
              Every piece of equipment, every training method, every philosophy we embrace serves one purpose:
              <strong>to strip away everything and reveal what you're truly made of</strong>.
            </p>
          </div>
        </div>

        <div class="story-stats">
          <h3><i class="fa-solid fa-chart-line"></i> BY THE NUMBERS</h3>
          <div class="stats-grid reveal-on-scroll stagger-children">
            <div class="stat-item">
              <span class="stat-number">2,500+</span>
              <span class="stat-label">Fighters Trained</span>
            </div>
            <div class="stat-item">
              <span class="stat-number">150+</span>
              <span class="stat-label">Fight Victories</span>
            </div>
            <div class="stat-item">
              <span class="stat-number">50,000+</span>
              <span class="stat-label">Hours of Training</span>
            </div>
            <div class="stat-item">
              <span class="stat-number">100%</span>
              <span class="stat-label">Commitment Required</span>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ============================================================
       7. OUR CODE (CORE VALUES)
       Background: DARK (bg-dark) — kept as-is
  ============================================================ -->
  <section class="core-values section bg-dark" id="values">
    <div class="container">
      <h2 class="section-title text-center">
        <i class="fa-solid fa-fist-raised"></i>
        OUR CODE
      </h2>

      <div class="values-grid reveal-on-scroll stagger-children">

        <div class="value-card">
          <div class="value-icon">
            <i class="fa-solid fa-shield-alt"></i>
          </div>
          <h3>NO PARTICIPATION TROPHIES</h3>
          <p>
            Results are earned, not given. We measure success in sweat, determination,
            and the willingness to get back up after being knocked down.
          </p>
        </div>

        <div class="value-card">
          <div class="value-icon">
            <i class="fa-solid fa-hammer"></i>
          </div>
          <h3>STRENGTH THROUGH STRUGGLE</h3>
          <p>
            Comfort is the enemy of growth. We embrace discomfort as the price of
            transformation and the pathway to unbreakable mental toughness.
          </p>
        </div>

        <div class="value-card">
          <div class="value-icon">
            <i class="fa-solid fa-users"></i>
          </div>
          <h3>BROTHERHOOD THROUGH BATTLE</h3>
          <p>
            The bonds forged in training are stronger than blood. When you suffer together,
            sweat together, and push each other to new limits, you become family.
          </p>
        </div>

        <div class="value-card">
          <div class="value-icon">
            <i class="fa-solid fa-target"></i>
          </div>
          <h3>AUTHENTICITY OVER EVERYTHING</h3>
          <p>
            No fake motivational quotes. No instagram filters. Just raw, honest training
            that disregards convenience and ensures a champion mentality.
          </p>
        </div>

      </div>
    </div>
  </section>

  <!-- ============================================================
       8. FORGED LEADERS
       Background: LIGHT 1 (ghost-white)
  ============================================================ -->
  <section class="leadership section" id="leaders">
    <div class="container">
      <h2 class="section-title text-center">
        <i class="fa-solid fa-crown"></i>
        HARDENED LEADERS
      </h2>

      <div class="leadership-grid reveal-on-scroll stagger-children">

        <div class="leader-card">
          <div class="leader-image duotone-gold-black" style="background: url('/images/leader-mike-rodriguez-coach-and-founder.webp'); background-size: cover; background-position: center;">
          </div>
          <div class="leader-content">
            <h3>"Iron" Mike Rodriguez</h3>
            <p class="leader-title">Head Coach & Founder</p>
            <p class="leader-bio">
              Former professional boxer with 15 years in the ring. Believes that
              true strength comes from facing your fears head-on and never backing down.
            </p>
            <div class="leader-credentials">
              <span><i class="fa-solid fa-medal"></i> 25-3 Professional Record</span>
              <span><i class="fa-solid fa-graduation-cap"></i> Certified Boxing Coach</span>
            </div>
          </div>
        </div>

        <div class="leader-card">
          <div class="leader-image duotone-gold-black" style="background: url('/images/leader-sarah-chen-mma-director.webp'); background-size: cover; background-position: center;">
          </div>
          <div class="leader-content">
            <h3>Sarah Chen</h3>
            <p class="leader-title">MMA Director</p>
            <p class="leader-bio">
              Black belt in Brazilian Jiu-Jitsu and former MMA competitor.
              Specializes in turning mental toughness into physical dominance.
            </p>
            <div class="leader-credentials">
              <span><i class="fa-solid fa-medal"></i> BJJ Black Belt</span>
              <span><i class="fa-solid fa-graduation-cap"></i> MMA Coach Certification</span>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ============================================================
       9. READY TO BE FORGED? (CTA)
       Background: LIGHT 2 (subtle tri-gradient)
  ============================================================ -->
  <section class="about-cta section" id="forged">
    <div class="container">
      <div class="cta-content reveal-on-scroll">
        <h2 class="cta-title">READY FOR THE PIT?</h2>
        <p class="cta-text">
          The Scrap Pit isn't for everyone. The door is open. What you do with it is yours.
        </p>
        <div class="cta-actions">
          <CombatButton
            text="Start Your Trial"
            href="#contact"
            variant="accent"
            size="mega"
            className="cta-primary"
          />
          <CombatButton
            text="View Pricing"
            href="#pricing"
            variant="victory"
            size="large"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       10. PRICING HEADER
       Background: DARK (iron-black gradient)
  ============================================================ -->
  <section class="pricing-hero section section-header-animated" id="pricing">
    <div class="container">
      <div class="pricing-hero-content">
        <h1 class="display-title">CHOOSE YOUR TRAINING</h1>
        <p class="display-subtitle">PRICING PLANS FOR EVERY FIGHTER</p>
        <p class="hero-description">
          From beginner to champion, we have a plan that fits your commitment level and goals.
        </p>
      </div>
    </div>
  </section>

  <!-- ============================================================
       11. PRICING PLANS + ADDITIONAL OPTIONS
       Background: LIGHT 1 (ghost-white)
  ============================================================ -->
  <section class="pricing-plans section" id="plans">
    <div class="container">

      <div class="pricing-grid reveal-on-scroll stagger-children">

        <!-- Warrior Plan -->
        <div class="pricing-card basic">
          <div class="card-header">
            <div class=" warrior-icon">
              <i class="fa-solid fa-shield"></i>
            </div>
            <h3 class="plan-name">WARRIOR</h3>
            <p class="plan-subtitle">Where it starts</p>
          </div>

          <div class="card-pricing">
            <span class="price">$89</span>
            <span class="period">/month</span>
          </div>

          <div class="card-features">
            <ul class="features-list">
              <li><i class="fa-solid fa-check"></i> 8 Classes per month</li>
              <li><i class="fa-solid fa-check"></i> Basic locker access</li>
              <li><i class="fa-solid fa-check"></i> Open gym access</li>
              <li><i class="fa-solid fa-check"></i> Beginner workshops</li>
              <li><i class="fa-solid fa-times"></i> Personal training</li>
              <li><i class="fa-solid fa-times"></i> Advanced seminars</li>
            </ul>
          </div>

          <div class="card-action">
            <CombatButton
                text="Start Training"
                href="#contact"
                variant="ghost"
                size="large"
                className="pricing-btn" />
          </div>
        </div>

        <!-- Champion Plan (Popular) -->
        <div class="pricing-card popular">
          <div class="popular-badge">
            <i class="fa-solid fa-crown"></i>
            MOST POPULAR
          </div>

          <div class="card-header">
            <div class="plan-icon">
              <i class="fa-solid fa-fist-raised"></i>
            </div>
            <h3 class="plan-name">CHAMPION</h3>
            <p class="plan-subtitle">The full commitment</p>
          </div>

          <div class="card-pricing">
            <span class="price">$149</span>
            <span class="period">/month</span>
          </div>

          <div class="card-features">
            <ul class="features-list">
              <li><i class="fa-solid fa-check"></i> Unlimited classes</li>
              <li><i class="fa-solid fa-check"></i> Premium locker</li>
              <li><i class="fa-solid fa-check"></i> 24/7 gym access</li>
              <li><i class="fa-solid fa-check"></i> All workshops</li>
              <li><i class="fa-solid fa-check"></i> 2 Personal training/month</li>
              <li><i class="fa-solid fa-check"></i> Advanced seminars</li>
            </ul>
          </div>

          <div class="card-action">
            <CombatButton
                text="Become Champion"
                href="#contact"
                variant="accent"
                size="large"
                className="pricing-btn" />
          </div>
        </div>

        <!-- Legend Plan -->
        <div class="pricing-card premium">
          <div class="card-header">
            <div class="plan-icon">
              <i class="fa-solid fa-trophy"></i>
            </div>
            <h3 class="plan-name">LEGEND</h3>
            <p class="plan-subtitle">Unmatched experience</p>
          </div>

          <div class="card-pricing">
            <span class="price">$249</span>
            <span class="period">/month</span>
          </div>

          <div class="card-features">
            <ul class="features-list">
              <li><i class="fa-solid fa-check"></i> Unlimited everything</li>
              <li><i class="fa-solid fa-check"></i> VIP locker room</li>
              <li><i class="fa-solid fa-check"></i> Private training area</li>
              <li><i class="fa-solid fa-check"></i> Priority class booking</li>
              <li><i class="fa-solid fa-check"></i> Unlimited personal training</li>
              <li><i class="fa-solid fa-check"></i> Exclusive events</li>
            </ul>
          </div>

          <div class="card-action">
            <CombatButton
                text="Join Elite"
                href="#contact"
                variant="victory"
                size="large"
                className="pricing-btn" />
          </div>
        </div>

      </div>

      <!-- Additional Options -->
      <div class="additional-options">
        <h2 class="section-title">
          <i class="fa-solid fa-plus"></i>
          ADDITIONAL OPTIONS
        </h2>

        <div class="options-grid reveal-on-scroll stagger-children">
          <div class="option-card">
            <h4><i class="fa-solid fa-clock"></i> Day Pass</h4>
            <p class="option-price">$25</p>
            <p>One session. See for yourself.</p>
          </div>

          <div class="option-card">
            <h4><i class="fa-solid fa-calendar-week"></i> Weekly Pass</h4>
            <p class="option-price">$65</p>
            <p>One week unlimited access</p>
          </div>

          <div class="option-card">
            <h4><i class="fa-solid fa-user-graduate"></i> Personal Training</h4>
            <p class="option-price">$80/session</p>
            <p>One-on-one expert coaching</p>
          </div>

          <div class="option-card">
            <h4><i class="fa-solid fa-users"></i> Small Group (2-4)</h4>
            <p class="option-price">$45/person</p>
            <p>Semi-private training</p>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- ============================================================
       12. 30-DAY WARRIOR GUARANTEE
       Background: LIGHT 1 (ghost-white) — changed from bg-dark
  ============================================================ -->
  <section class="guarantee section" id="guarantee">
    <div class="container">
      <div class="guarantee-content reveal-on-scroll">
        <div class="guarantee-icon">
          <i class="fa-solid fa-medal"></i>
        </div>
        <h2 class="guarantee-title">30-DAY WARRIOR GUARANTEE</h2>
        <p class="guarantee-text">
          Not satisfied with your training? Get a full refund within 30 days.
          We've never had to honor it.
        </p>
        <div class="guarantee-action">
          <CombatButton text="Start Risk-Free Trial" href="#contact" variant="victory" size="mega" />
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       13. CONTACT HEADER
       Background: DARK (iron-black gradient)
  ============================================================ -->
  <section class="contact-hero section section-header-animated" id="contact">
    <div class="container">
      <div class="contact-hero-content">
        <h1 class="display-title">CONTACT THE PIT</h1>
        <p class="display-subtitle">READY TO START YOUR JOURNEY?</p>
        <p class="hero-description">
          Step into our octagon. Tell us where you are. We'll tell you what comes next.
        </p>
      </div>
    </div>
  </section>

  <!-- ============================================================
       14. CONTACT CONTENT
       Background: LIGHT 1 (ghost-white)
  ============================================================ -->
  <section class="contact-content section" id="contact-form">
    <div class="container">
      <div class="contact-grid reveal-on-scroll">

        <!-- Contact Form -->
        <div class="contact-form-section">
          <h2 class="section-title">
            <i class="fa-solid fa-fist-raised"></i>
            GET IN TOUCH
          </h2>

          <form class="contact-form">
            <div class="form-group">
              <label for="name">NAME</label>
              <input type="text" id="name" name="name" required>
            </div>

            <div class="form-group">
              <label for="email">EMAIL</label>
              <input type="email" id="email" name="email" required>
            </div>

            <div class="form-group">
              <label for="phone">PHONE</label>
              <input type="tel" id="phone" name="phone">
            </div>

            <div class="form-group">
              <label for="interest">TRAINING INTEREST</label>
              <select id="interest" name="interest">
                <option>Select Training Type</option>
                <option>Striking (Boxing, Muay Thai)</option>
                <option>Grappling (BJJ, Wrestling)</option>
                <option>Conditioning</option>
                <option>All Training Types</option>
              </select>
            </div>

            <div class="form-group">
              <label for="message">MESSAGE</label>
              <textarea id="message" name="message" rows="5" placeholder="Tell us about your goals..."></textarea>
            </div>

            <CombatButton
              text="Send Message"
              variant="accent"
              size="large"
              className="form-submit-btn"
            />
          </form>
        </div>

        <!-- Contact Info -->
        <div class="contact-info-section">
          <h2 class="section-title">
            <i class="fa-solid fa-location-dot"></i>
            FIND THE PIT
          </h2>

          <div class="contact-info">
            <div class="info-block">
              <h3><i class="fa-solid fa-map-marker-alt"></i> LOCATION</h3>
              <p>240 Industrial Blvd<br>Athens, GA 30601</p>
            </div>

            <div class="info-block">
