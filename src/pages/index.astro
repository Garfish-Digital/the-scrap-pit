}

// ============================================================
// TRAINING SECTION
// ============================================================

.training {
  padding: $space-mega $space-sm;

  .section-header {
    text-align: center;
    margin-bottom: $space-xxl;

    .section-title {
      font-size: $font-size-huge;
      margin-bottom: $space-md;
    }

    .section-description {
      font-size: $font-size-medium;
      max-width: 600px;
      margin: 0 auto;
      opacity: 0.8;
    }
  }

  .training-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: $space-xl;

    @media (max-width: 1366px) {
      grid-template-columns: repeat(2, 1fr);
      gap: $space-lg;
    }

    @media (max-width: $breakpoint-md) {
      grid-template-columns: 1fr;
      gap: $space-lg;
    }
  }

  .training-block {
    position: relative;
    border: $border-primary;
    background: $bg-primary;
    cursor: pointer;
    transition: all $transition-quick;

    &:hover {
      transform: translate(-6px, -6px);
      box-shadow: 10px 10px 0 $iron-black;

      .training-image {
        transform: scale(1.08);

        &.duotone-red-black {
          filter:
            grayscale(1)
            contrast(1.4)
            sepia(1)
            hue-rotate(315deg)
            saturate(1.2)
            brightness(1.1);
        }

        &.duotone-gold-black {
          filter:
            grayscale(1)
            contrast(1.3)
            sepia(1)
            hue-rotate(38deg)
            saturate(1.1)
            brightness(1.1);
        }

        &.tritone-combat {
          filter:
            grayscale(1)
            contrast(1.4)
            sepia(1)
            hue-rotate(0deg)
            saturate(1.05)
            brightness(1.1);
        }
      }

      .training-content {
        .training-title {
          text-shadow: 2px 2px 0 rgba($blood-red, 0.3);
        }

        .training-stats .stat {
          transform: scale(1.05);
          background: $blood-red;
        }
      }
    }

    // Click/tap impact — card compresses in, springs back on release
    &.impact {
      transform: translate(0, 0) scale(0.97) !important;
      box-shadow: 2px 2px 0 $iron-black !important;
      transition-duration: 0.08s !important;

      .training-image {
        transform: scale(1) !important;
      }
    }

    .training-image {
      position: relative;
      height: 300px;
      overflow: hidden;
      transition: transform 0.15s cubic-bezier(0.16, 1, 0.3, 1);

      .training-image-content {
        width: 100%;
        height: 100%;
      }
    }

    .training-overlay {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: linear-gradient(
        to bottom,
        transparent 0%,
        rgba($iron-black, 0.8) 100%
      );
    }

    .training-content {
      padding: $space-lg;

      .training-title {
        font-size: $font-size-large;
        margin-bottom: $space-md;
        color: $text-accent;
        transition: text-shadow 0.15s ease;
      }

      .training-description {
        margin-bottom: $space-md;
        line-height: $line-height-loose;
      }

      .training-stats {
        display: flex;
        gap: $space-sm;
        flex-wrap: wrap;

        .stat {
          display: inline-block;
          padding: $space-xs $space-sm;
          background: $iron-black;
          color: $text-inverse;
          font-size: $font-size-small;
          font-weight: 700;
          text-transform: uppercase;
          letter-spacing: 0.05em;
          transition: transform 0.1s cubic-bezier(0.68, -0.55, 0.27, 1.55),
                      background 0.15s ease;
        }
      }
    }
  }

  // Individual training block background images
  .training-block[data-stage="striking"] .training-image.duotone-red-black {
    background: url('/images/fighter-striking.webp');
    background-size: cover;
    background-position: center;
  }

  .training-block[data-stage="grappling"] .training-image.duotone-gold-black {
    background: url('/images/fighters-grappling.webp');
